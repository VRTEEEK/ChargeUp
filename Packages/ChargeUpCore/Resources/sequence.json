{
  "version": 1,
  "object": "lantern",
  "steps": [
    { "id": "cream",     "name": "Numbing cream on the port",
      "clinicalCue": "Cool cream, cling film, a long wait",
      "perceived": "The port glow grows under the skin",
      "childAction": "Let it work",
      "haptic": "none", "audio": "port_place",
      "advance": { "kind": "nurseTap" } },
    { "id": "clean",     "name": "Skin cleaned",
      "clinicalCue": "Cold, wet, brief",
      "perceived": "Port polished; frost shimmer",
      "childAction": "Watch the port shine",
      "haptic": "none", "audio": "frost",
      "advance": { "kind": "nurseTap" } },
    { "id": "countdown", "name": "Count of three",
      "clinicalCue": "Nurse says: three, two, one",
      "perceived": "Three pulses of light at the port, 800 ms apart",
      "childAction": "Take a breath, hold still",
      "haptic": "none", "audio": "pulse",
      "advance": { "kind": "nurseTap", "label": "CONNECT" } },
    { "id": "connect",   "name": "Port needle in",
      "clinicalCue": "Sharp push, then pressure",
      "perceived": "Cable clicks into the port",
      "childAction": "Look at the port, hold still",
      "haptic": "ramp", "audio": "click",
      "advance": { "kind": "auto", "durationMs": 400 } },
    { "id": "flush",     "name": "Flush and blood draw",
      "clinicalCue": "Cold in the chest, a strange taste",
      "perceived": "The first spark runs up the cable and the lantern wakes",
      "childAction": "Watch the spark",
      "haptic": "none", "audio": "spark",
      "advance": { "kind": "nurseTap" } },
    { "id": "charge",    "name": "Infusion",
      "clinicalCue": "Hours on the pump; free to move, rest or sleep",
      "perceived": "The lantern fills over time",
      "childAction": "Come back and look whenever you like",
      "haptic": "none", "audio": "flow_loop",
      "advance": { "kind": "nurseTap", "label": "NEEDLE OUT" } },
    { "id": "release",   "name": "Needle out and dressing",
      "clinicalCue": "Pull, pressure, adhesive",
      "perceived": "Cable disconnects; lantern fully lit and rises to join the sky; a charge mark fades onto the dressing",
      "childAction": "Watch it rise",
      "haptic": "none", "audio": "complete",
      "advance": { "kind": "nurseTap", "label": "DONE" } }
  ],
  "prompts": {
    "idle": "We're getting your lantern ready.",
    "cream": "The cream is making the port sleepy. Nothing to do yet.",
    "clean": "Watch the port, it's getting cold and shiny.",
    "countdown": "Big breath in, hold still, it's about to connect.",
    "connect": "There's the click. Look at the port.",
    "flush": "Here comes the first spark. Watch it climb.",
    "charge": "Your lantern is filling on its own. Rest if you like.",
    "release": "And out. Watch your lantern rise.",
    "complete": "All charged. That one's yours now."
  },
  "config": {
    "visuals": {
      "creamGlowMs": 4000,
      "countdownPulseCount": 3,
      "countdownPulseMs": 800,
      "cableSnapMs": 150,
      "flushSparkMs": 1200,
      "cableRetractMs": 400,
      "markFadeMs": 800,
      "flowPacketCount": 6,
      "flowSpeedMps": 0.5,
      "frostSparkleCount": 8
    },
    "audio": {
      "portGainDb": 0,
      "lanternGainDb": -6,
      "lanternSounds": ["flow_loop"],
      "loopingSounds": ["flow_loop"]
    },
    "lantern": {
      "forwardM": 0.4,
      "belowHeadM": 0.3,
      "fallbackHeadHeightM": 1.6,
      "headPoseWaitMs": 1500,
      "simulatedForwardM": 0.7,
      "simulatedBelowHeadM": 0.12
    },
    "sky": {
      "seededSessions": 6,
      "riseSeconds": 3,
      "clusterHeightM": 0.55,
      "clusterBehindM": 0.35,
      "clusterSpreadM": 0.7,
      "smallScale": 0.4
    },
    "charge": {
      "gatedByPresence": false,
      "demoDurationSec": 90,
      "glanceDegrees": 20,
      "glanceSeconds": 2.5
    },
    "stillnessThresholdMps": 0.05,
    "stillnessWindowMs": 300,
    "headOnPortDegrees": 25,
    "rampIntensity": [0.2, 1.0],
    "rampSharpness": 0.3,
    "rampDurationMs": 4000,
    "rehearsalIntervalMs": 3000,
    "forearm": {
      "heldArm": "left",
      "portOffsetProximalMm": 60,
      "forearmRadiusMm": 25,
      "dorsalAxis": "+y",
      "holdLastPoseMs": 2000,
      "occludedOpacity": 0.5,
      "fadeMs": 300,
      "filterMinCutoffHz": 1.0,
      "filterBeta": 2.0,
      "filterDerivativeCutoffHz": 1.0,
      "filterMaxStepMs": 100,
      "simulatedForearm": true,
      "simulatedPath": {
        "center": [-0.22, 1.42, -0.62],
        "radiusMm": 40,
        "periodS": 8,
        "normal": [0.0, 0.6, 0.8]
      }
    }
  }
}
