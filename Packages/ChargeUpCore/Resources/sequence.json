{
  "version": 1,
  "object": "lantern",
  "steps": [
    { "id": "cream", "companion": "waveIn",     "name": "Numbing cream on the port",
      "clinicalCue": "Cool cream, cling film, a long wait",
      "perceived": "The jewel port appears on the arm and its amber glass slowly warms; a few golden motes drift up from it",
      "childAction": "Let it work",
      "haptic": "none", "audio": "port_place",
      "advance": { "kind": "nurseTap" } },
    { "id": "clean", "companion": "idle",     "name": "Skin cleaned",
      "clinicalCue": "Cold, wet, brief",
      "perceived": "Port polished; frost shimmer; a ring of sparkles in many colours circles the port, each leaving a glowing trail",
      "childAction": "Watch the port shine",
      "haptic": "none", "audio": "frost",
      "advance": { "kind": "nurseTap" } },
    { "id": "countdown", "companion": "listen", "name": "Count of three",
      "clinicalCue": "Nurse says: three, two, one",
      "perceived": "Three pulses of light at the port, 800 ms apart",
      "childAction": "Take a breath, hold still",
      "haptic": "none", "audio": "pulse",
      "advance": { "kind": "nurseTap", "label": "CONNECT" } },
    { "id": "connect", "companion": "listen",   "name": "Port needle in",
      "clinicalCue": "Sharp push, then pressure",
      "perceived": "With a click, a thin amber stream springs from the port's glass toward the lantern",
      "childAction": "Look at the port, hold still",
      "haptic": "ramp", "audio": "click",
      "advance": { "kind": "auto", "durationMs": 400 } },
    { "id": "flush", "companion": "lookOnce",     "name": "Flush and blood draw",
      "clinicalCue": "Cold in the chest, a strange taste",
      "perceived": "The first golden spark flies along the stream into the lantern, and the lantern wakes",
      "childAction": "Watch the spark",
      "haptic": "none", "audio": "spark",
      "advance": { "kind": "nurseTap" } },
    { "id": "charge", "companion": "charging",    "name": "Infusion",
      "clinicalCue": "Hours on the pump; free to move, rest or sleep",
      "perceived": "Golden fireflies flow from the port into the lantern, which floats gently on the spot and fills over time, its light pulsing brighter and dimmer, quicker as it fills",
      "childAction": "Come back and look whenever you like",
      "haptic": "none", "audio": "flow_loop",
      "advance": { "kind": "nurseTap", "label": "NEEDLE OUT" } },
    { "id": "release", "companion": "heartCheer",   "name": "Needle out and dressing",
      "clinicalCue": "Pull, pressure, adhesive",
      "perceived": "The stream draws back into the port; lantern fully lit and flies to hang on the lantern tree, which flares as it lands; a glowing badge fades onto the arm where the port was, breathing gently, a few golden motes still drifting from it",
      "childAction": "Watch it fly to the tree",
      "haptic": "none", "audio": "complete",
      "advance": { "kind": "nurseTap", "label": "DONE" } }
  ],
  "prompts": {
    "idle":      { "en": "We're getting your lantern ready.",
                   "ar": "نجهّز فانوسك الآن." },
    "cream":     { "en": "The cream is making the port sleepy. Nothing to do yet.",
                   "ar": "الكريم يُنيّم مكان الإبرة. لا شيء عليك فعله الآن." },
    "clean":     { "en": "Watch the port, it's getting cold and shiny.",
                   "ar": "انظر إلى المنفذ، يصبح بارداً ولامعاً." },
    "countdown": { "en": "Big breath in, hold still, it's about to connect.",
                   "ar": "خذ نفساً عميقاً، وابقَ ثابتاً، سيتصل الآن." },
    "connect":   { "en": "There's the click. Look at the port.",
                   "ar": "ها هي الطقطقة. انظر إلى المنفذ." },
    "flush":     { "en": "Here comes the first spark. Watch it climb.",
                   "ar": "ها هي الشرارة الأولى. شاهدها تصعد." },
    "charge":    { "en": "Your lantern is filling on its own. Rest if you like.",
                   "ar": "فانوسك يمتلئ وحده. ارتَح إن أحببت." },
    "release":   { "en": "And out. Watch your lantern rise.",
                   "ar": "وخرجت. شاهد فانوسك يرتفع." },
    "complete":  { "en": "All charged. That one's yours now.",
                   "ar": "اكتمل الشحن. هذا الفانوس لك الآن." }
  },
